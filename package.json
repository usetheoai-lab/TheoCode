{
  "name": "theocode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A terminal coding agent: one agent core, two surfaces.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx packages/tui/src/main.tsx",
    "exec": "tsx packages/cli/src/main.ts",
    "build": "node tools/build-cli.mjs && npm run build:acp",
    "build:acp": "esbuild packages/agent/src/chat-acp.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/acp-entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node tools/check-english-only.mjs --quiet && node tools/check-artifact-promotion.mjs --quiet",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "lint:english": "node tools/check-english-only.mjs",
    "crossval": "python3 tools/check-backlog-crossval.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@theokit/sdk": "^4.47.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "dependency-cruiser": "18.1.1",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "theocode": "./dist/theocode.mjs"
  },
  "overrides": {
    "@theokit/presenter": "^0.5.1"
  }
}
